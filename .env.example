# ─────────────────────────────────────────────────────────────────────────────
# Groww Review Intelligence Agent — Environment Variables
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider (set one) ────────────────────────────────────────────────────
# For Gemini:
GEMINI_API_KEY=your-gemini-api-key-here

# For OpenAI:
# OPENAI_API_KEY=your-openai-api-key-here

# Which provider to use: "gemini" or "openai"
LLM_PROVIDER=gemini

# ── MCP Server Configuration (Google Workspace MCP Server) ───────────────────
# The agent connects via Model Context Protocol (Streamable HTTP / SSE)
# Production Railway deployment:
MCP_SERVER_URL=https://mcp-server-production-3be3.up.railway.app

# Optional Bearer API key (if configured on your MCP server)
MCP_API_KEY=

# ── Google Workspace Integration (via MCP) ───────────────────────────────────
# Google Doc ID or URL where weekly pulses are non-destructively appended
PULSE_DOC_ID=https://docs.google.com/document/d/1escKRi5Z9d6H_gZSOxAvhEragRm52d0I_a6JfGP5Mdk/edit?usp=sharing

# Email address to send the weekly pulse note to via MCP gmail_send_email
PULSE_EMAIL_RECIPIENT=myaiusagee@gmail.com

# ── Optional Overrides (uncomment to override settings.yaml values) ───────────
# REVIEW_WINDOW_WEEKS=10
# MAX_REVIEWS=500
# MIN_REVIEW_LENGTH=20
# NON_ENGLISH_POLICY=keep
# MAX_THEMES=5
# PULSE_THEMES=3
# PULSE_MAX_WORDS=250
# LOG_LEVEL=INFO
